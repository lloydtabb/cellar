##! experimental { givens }

// A search page, not an analysis page.
//
// This used to carry a score histogram, an average-by-year line, best-producers
// and best-regions bars, plus three overlapping tables — which mostly restated
// each other, and none of which helped anyone find a particular note. What an
// owner wants from a pile of tasting notes is to find the one they're thinking
// of, so the whole page is now filters plus one list.
//
// Runs on `tasting_notes` (grain = the note), so the averages are unweighted —
// one note, one vote.
//
// The searches compose: producer "Rousseau" + note contains "still closed"
// answers "have I ever written that a Rousseau needed more time".

import "../cellar.malloy"
import "../givens.malloy"

#" Find a note — by wine, producer, region, score, or what you wrote.
# artifact { title="Tasting Notes" }
# dashboard { columns=6 }
query: tasting is tasting_notes -> {
  where:
    owner.cellar_name ~ $CELLAR,
    wine ~ $WINE,
    producer ~ $PRODUCER,
    region ~ $REGION,
    style ~ $STYLE,
    rating ~ $SCORE,
    tasting_date ~ $PERIOD,
    // `searchable` (see cellar.malloy) is the wine, producer, event title and
    // note text in one lowercased string. Wrapped in wildcards so a bare word
    // is a substring search; empty matches everything.
    searchable ~ concat('%', lower($SEARCH), '%')

  // Just enough to say how big the result set is and whether the slice you've
  // filtered down to actually scored well.
  # colspan=2
  aggregate:
    # label="Notes found"
    note_count
    # label="Average score"
    avg_rating
    # label="Best score"
    best_rating

  # colspan=6
  nest:
    # break
    # label="Notes"
    matching_notes is {
      group_by:
        # label="Tasted"
        tasting_date
        # label="Score"
        rating
        wine
        producer
        # label="Vintage"
        vintage_label
        # label="Opened at"
        event_title
        # label="What you wrote"
        tasting_note
      order_by: tasting_date desc
      limit: 500
    }
}
